<Project Sdk="Aspire.AppHost.Sdk/13.6.0">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>card-arena-apphost</UserSecretsId>
    <!-- "dotnet run" and Visual Studio use the dashboard and orchestrator from NuGet, so the separate Aspire CLI isn't needed. -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Azure.Storage" Version="13.6.2" />
    <PackageReference Include="Aspire.Hosting.RabbitMQ" Version="13.6.2" />
    <PackageReference Include="Aspire.Hosting.SqlServer" Version="13.6.2" />
    <!-- Pinned above the vulnerable 9.0.11/10.0.12 that Azure and Aspire packages bring in (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7). -->
    <PackageReference Include="Azure.Storage.Blobs" Version="12.30.1" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- Pinned above the vulnerable 2.5.302 that Aspire pulls in transitively (GHSA-qhrr-8q5h-9q3h). -->
    <PackageReference Include="MessagePack" Version="2.5.307" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\3.BackendAPI\Game.Api\Game.Api.csproj" />
    <ProjectReference Include="..\..\4.Frontend\Game.Client\Game.Client.csproj" />
  </ItemGroup>

</Project>
